{
  "name": "live-performance-center",
  "version": "1.0.0",
  "private": true,
  "description": "Live technician-performance dashboard and presentation controller",
  "workspaces": [
    "apps/backend",
    "apps/dashboard",
    "apps/remote"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:backend": "npm run dev --workspace=@grmetro/backend",
    "dev:dashboard": "npm run dev --workspace=@grmetro/dashboard",
    "dev:remote": "npm run dev --workspace=@grmetro/remote",
    "build": "npm run build --workspaces --if-present",
    "test": "node --test tests/*.test.js && npm run test --workspaces --if-present",
    "start": "npm run start --workspace=@grmetro/backend",
    "setup:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows/setup-performance-center.ps1",
    "start:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows/start-performance-center.ps1",
    "edge:dashboard": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows/launch-edge.ps1",
    "generate:qr": "node scripts/generate-qr-codes.js"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
