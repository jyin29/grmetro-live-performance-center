NODE_ENV=development

HOST=127.0.0.1
PORT=3000

EDGE_DEBUG_URL=http://127.0.0.1:9222
EDGE_CONNECTION_TIMEOUT_MILLISECONDS=30000
SERVICETITAN_BASE_URL=https://go.servicetitan.com
SERVICETITAN_REQUEST_TIMEOUT_MILLISECONDS=20000
SERVICETITAN_CSRF_TIMEOUT_MILLISECONDS=10000
SERVICETITAN_RELOAD_KEY=2
SERVICETITAN_DRILLDOWN_KPI_TYPE=2
TIMEZONE=America/New_York

REFRESH_INTERVAL_SECONDS=60
REMOTE_OVERRIDE_SECONDS=120
RETURN_TRANSITION_MILLISECONDS=1000
STALE_WARNING_SECONDS=180
STALE_CRITICAL_SECONDS=600
SNAPSHOT_RETENTION_LIMIT=1440
TREND_MINIMUM_HISTORY=4

DASHBOARD_BASE_URL=http://127.0.0.1:3000

MOCK_MODE=false
ENABLE_DEVELOPMENT_ROUTES=true

# Structured logs are written to stdout.
LOG_LEVEL=info
JSON_BODY_LIMIT=100kb
REMOTE_RATE_LIMIT_WINDOW_SECONDS=60
REMOTE_RATE_LIMIT_MAX_REQUESTS=30
