NODE_ENV=development

HOST=127.0.0.1
PORT=3000

# Company-specific values should live in the ignored data/company-config.json file.
# Override this only if you keep the private file somewhere else.
COMPANY_CONFIG_PATH=data/company-config.json

EDGE_DEBUG_URL=http://127.0.0.1:9223
EDGE_CONNECTION_TIMEOUT_MILLISECONDS=30000
SERVICETITAN_BASE_URL=https://go.servicetitan.com
SERVICETITAN_REQUEST_TIMEOUT_MILLISECONDS=20000
SERVICETITAN_CSRF_TIMEOUT_MILLISECONDS=10000
SERVICETITAN_RELOAD_KEY=2
SERVICETITAN_DRILLDOWN_KPI_TYPE=2
# Optional comma-separated override. Leave blank to use company-config.json.
SERVICETITAN_BUSINESS_UNIT_IDS=
TIMEZONE=America/New_York

REFRESH_INTERVAL_SECONDS=60
REMOTE_OVERRIDE_SECONDS=120
RETURN_TRANSITION_MILLISECONDS=1000
STALE_WARNING_SECONDS=180
STALE_CRITICAL_SECONDS=600
SNAPSHOT_RETENTION_LIMIT=1440
TREND_MINIMUM_HISTORY=4

DASHBOARD_BASE_URL=http://127.0.0.1:3000

MOCK_MODE=false
ENABLE_DEVELOPMENT_ROUTES=true

# Human-readable logs are used in development. Set LOG_FORMAT=json when needed.
LOG_LEVEL=info
LOG_FORMAT=
JSON_BODY_LIMIT=100kb
REMOTE_RATE_LIMIT_WINDOW_SECONDS=60
REMOTE_RATE_LIMIT_MAX_REQUESTS=30

# Dashboard kiosk hardening (Vite build-time settings)
VITE_KIOSK_MODE=false
VITE_DIAGNOSTICS_VISIBLE=false
VITE_WATCHDOG_INTERVAL_MS=15000
VITE_PRESENTATION_STALE_MS=90000
VITE_DASHBOARD_STALE_MS=150000
VITE_RECONNECT_MINIMUM_MS=500
VITE_RECONNECT_MAXIMUM_MS=10000
VITE_CURSOR_IDLE_MS=3000
# VITE_BUILD_VERSION may be set to the deployed commit or release identifier.
VITE_BUILD_VERSION=
