# Dependencies and package-manager caches
node_modules/
.npm/

# Environment files may contain local configuration or secrets
.env
.env.*
!.env.example

# Company-specific/private configuration
# Keep the example template tracked; real company data stays local.
data/company-config.json
data/company-config.*.json
!data/company-config.example.json
company-config.json
company-config.*.json
private/
local-data/

# Company-specific branding/assets
assets/company/
apps/dashboard/public/company/

# Build and test output
dist/
build/
coverage/
.vite/

# Runtime output
*.log
logs/
*.pid

# Generated QR codes
assets/qr/*.png
assets/qr/*.svg
!assets/qr/.gitkeep

# Editor and operating-system files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Local ServiceTitan research output
*-drilldown-sanitized.json
*-drilldown-enhanced.json
drilldown-metadata*.json
servicetitan-research-results*.json
research-output/

# Runtime-managed business configuration
data/goals.json
data/goals.json.tmp
apps/backend/data/goals.json
data/display-settings.json
data/display-settings.json.tmp
apps/backend/data/display-settings.json
apps/backend/data/spreadsheet-slide.json
