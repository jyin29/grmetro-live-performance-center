# Dependencies and package-manager caches
node_modules/
.npm/

# Environment files may contain local configuration or secrets
.env
.env.*
!.env.example

# Build and test output
dist/
build/
coverage/
.vite/
playwright-report/
test-results/
*.trace.zip
*.har

# Runtime output
*.log
logs/
*.pid

# Browser/session material must never enter source control
storage-state*.json
auth-state*.json
cookies*.json
session*.json
browser-profile/
edge-profile/
edge-*-profile/

# Generated QR codes
assets/qr/*.png
assets/qr/*.svg
!assets/qr/.gitkeep

# Editor and operating-system files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Local ServiceTitan research/output. These files may contain company or employee data.
*-drilldown-sanitized.json
*-drilldown-enhanced.json
drilldown-metadata*.json
servicetitan-research-results*.json
servicetitan-response*.json
servicetitan-raw*.json
research-output/

# Runtime-managed business configuration
data/goals.json
data/goals.json.tmp
apps/backend/data/goals.json
data/display-settings.json
data/display-settings.json.tmp
apps/backend/data/display-settings.json
apps/backend/data/spreadsheet-slide.json

# Local company/deployment configuration
config/*.local.json
config/*.private.json
apps/backend/config/*.local.json
apps/backend/config/*.private.json
